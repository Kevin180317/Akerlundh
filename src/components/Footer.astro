---
import { FaFacebook, FaInstagram } from "react-icons/fa6";

let date = new Date().getFullYear();
---

<main>
  <footer
    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 md:w-[80%] mx-auto gap-8 py-16 md:py-4 h-auto items-start md:px-0 px-8"
  >
    <div class="flex flex-col">
      <h1 class="text-3xl font-bold mb-8">About Us</h1>
      <p class="text-xl font-light mb-4">
        Our dedicated home interior designers work with you tirelessly to tie
        your style with their design expertise, creating the perfect interior
        design concept.
      </p>
      <a
        class="text-amber-500 text-xl font-bold cursor-pointer
        hover:text-amber-600 hover:underline"
        href="mailto:hfcustomdesign@gmail.com?subject=Consulta&body=Hola, me gustaría obtener más información."
        >hfcustomdesign@gmail.com
      </a>
    </div>
    <div class="flex flex-col">
      <h1 class="text-3xl font-bold mb-8">Features</h1>
      <ul class="text-xl space-y-4 cursor-pointer">
        <li>
          <a href="/" class="hover:text-amber-600 hover:underline"> Home </a>
        </li>
        <li>
          <a href="/project" class="hover:text-amber-600 hover:underline">
            Projects
          </a>
        </li>
        <li>
          <a href="/services" class="hover:text-amber-600 hover:underline">
            Services
          </a>
        </li>
        <li>
          <a href="/about" class="hover:text-amber-600 hover:underline">
            About
          </a>
        </li>
        <li>
          <a href="/contact" class="hover:text-amber-600 hover:underline">
            Contact
          </a>
        </li>
      </ul>
    </div>
    <div class="flex flex-col">
      <h1 class="text-3xl font-bold mb-8">Follow Us</h1>
      <p class="text-xl font-light mb-4">
        Explore thousands of inspiring interior designs, from our best team
        here.
      </p>
      <div class="flex gap-4">
        <a
          href="https://www.facebook.com/profile.php?id=61560814906853"
          target="_blank"
        >
          <FaFacebook
            className="text-3xl hover:text-amber-600 cursor-pointer "
          />
        </a>
        <a href="https://www.instagram.com/hf_customdesign/" target="_blank">
          <FaInstagram
            className="text-3xl hover:text-amber-600 cursor-pointer "
          />
        </a>
      </div>
    </div>
    <div class="flex flex-col">
      <h1 class="text-3xl font-bold mb-8">Useful Links</h1>
      <ul class="text-xl space-y-4 cursor-pointer">
        <li>
          <a
            href="/terms-and-conditions"
            class="hover:text-amber-600 hover:underline"
          >
            Terms & Conditions
          </a>
        </li>
        <li>
          <a
            href="/privacy-policy"
            class="hover:text-amber-600 hover:underline"
          >
            Privacy Policy
          </a>
        </li>
      </ul>
    </div>

    <hr />
  </footer>
  <hr class="border border-black w-full" />
  <div class="hidden w-[80%] mx-auto md:flex justify-center items-center">
    <p class="text-start text-[18px] font-light py-4">
      © {date}
      {" "}
      <a href="/" class="hover:text-amber-600 hover:underline"> Akerlundh. </a>
      {" "}
      All rights reserved.
    </p>
  </div>
</main>
