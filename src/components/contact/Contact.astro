---
import ContactForm from "@components/Contact";
---

<main class="mt-16 py-8">
  <ContactForm client:visible />
</main>
<div
  class="flex justify-start items-start flex-col md:w-[80%] px-8 md:px-0 mx-auto"
>
  <h1 class="text-4xl mb-8">
    Get in touch with us to design your{" "}
    <strong class="text-yellow-500">dream</strong> home
  </h1>

  <iframe
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d429161.0354158165!2d-117.73156056995346!3d32.82351837027731!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x80d9530fad921e4b%3A0xd3a21fdfd15df79!2sSan%20Diego%2C%20California%2C%20EE.%20UU.!5e0!3m2!1ses-419!2smx!4v1739250601431!5m2!1ses-419!2smx"
    width="800"
    height="450"
    class="mb-8 w-full h-64 md:h-[450px] border-0"
    style={{ border: "0" }}
    allowfullscreen=""
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"></iframe>
</div>
