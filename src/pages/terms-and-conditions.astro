---
import Layout from "@layouts/Layout.astro";
import Footer from "@components/Footer.astro";
import { slide } from "astro:transitions";
import Terminos from "@components/Terminos.astro";
---

<Layout title="Akerlundh Interior Design | San Diego, Tijuana">
  <main class="h-full w-full" transition:animate={slide({ duration: "1s" })}>
    <Terminos />
    <hr class="w-full border-black" />
    <Footer />
  </main>
</Layout>
