---
import Layout from "@layouts/Layout.astro";
import Footer from "@components/Footer.astro";
import { slide } from "astro:transitions";
import ProjectSection from "@components/project/Projects";

let projects = [
  {
    title: "Dining Area with Upholstered Bench and Marble Tables",
    href: "/projects/project1",
    image: "/project-1.webp",
  },
  {
    title: "Theater Installation with Structures and Moldings",
    href: "/projects/project2",
    image: "/project-2.webp",
  },
  {
    title: "Terrace with Custom Furniture and Contemporary Design",
    href: "/projects/project3",
    image: "/project-3.webp",
  },
  {
    title:
      "Waiting Area in Sales Showroom at Everett.lat – Designed by Casa Duhagon",
    href: "/projects/project4",
    image: "/project-4.webp",
  },
  {
    title: "Curved Walnut Display Furniture for Puesto Restaurant Apparel",
    href: "/projects/project5",
    image: "/project-5.webp",
  },
];

const projectsPerPage = 6;
---

<Layout title="Akerlundh">
  <main transition:animate={slide({ duration: "1s" })}>
    <ProjectSection
      client:visible
      projects={projects}
      projectsPerPage={projectsPerPage}
    />
    <hr class="w-full border-black" />
    <Footer />
  </main>
</Layout>
